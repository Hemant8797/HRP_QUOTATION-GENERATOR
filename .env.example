# MongoDB (local instance or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/hrp_quotations

# Express API
PORT=4000
# Comma-separated frontend URLs allowed to call the API (only needed when the frontend is hosted on a different origin).
CORS_ORIGIN=http://localhost:5173

# Optional. Leave unset to use the same-origin /api path (Vite proxies it in development).
# Set it only when the frontend is deployed separately from the API, e.g. https://api.example.com/api
# VITE_API_URL=
